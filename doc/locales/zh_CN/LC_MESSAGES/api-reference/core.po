msgstr ""
"- energy: 基态能量，单位为 Hartree - convergence: 收敛信息 - density_matrix: 电子密度矩阵 - method: "
"hf_reference（未进行相位估计测量）"

#: of q2m3.core.qpe.QPEEngine.estimate_ground_state_energy:10
msgid "energy: Ground state energy in Hartree"
msgstr "energy: 基态能量，单位为 Hartree"

