#: of q2m3.utils.io.save_json_results:1
msgid "Save calculation results as strict JSON, including immutable dataclasses."
msgstr "将计算结果保存为严格 JSON，支持不可变数据类。"

#: of q2m3.utils.io.save_json_results:3
msgid ""
"Results mapping or dataclass instance. Nested dataclasses, mappings, numpy values, and tuples are"
" converted recursively. Complex numbers use dictionaries with real and imag fields."
msgstr "结果映射或数据类实例。递归转换嵌套的数据类、映射、numpy 值和元组。复数使用包含 real 和 imag 字段的字典表示。"

#: of q2m3.utils.io.save_json_results:6
msgid "Output file path"
msgstr "输出文件路径"

#: of q2m3.utils.io.save_json_results:7
msgid "JSON indentation level"
msgstr "JSON 缩进级别"

#: of q2m3.utils.io.save_json_results:9
msgid "A numeric value is NaN or infinite."
msgstr "数值为 NaN 或无穷大。"

#: of q2m3.utils.io.save_json_results:10
msgid "A value cannot be represented in JSON."
msgstr "值无法用 JSON 表示。"

