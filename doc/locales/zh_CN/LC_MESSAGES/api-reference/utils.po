#: ../../source/api-reference/utils.rst:11
msgid "Plotting Helpers"
msgstr "绘图辅助函数"

#: of q2m3.utils.plotting:1
msgid "General plotting utilities for energy analysis."
msgstr "用于能量分析的通用绘图工具。"

#: of q2m3.utils.plotting:3
msgid "Provides cross-module visualization tools such as HF vs quantum energy comparison."
msgstr "提供跨模块可视化工具，例如 HF 能量与量子能量的比较。"

#: of q2m3.utils.plotting.plot_energy_comparison:1
msgid "Plot correlation between HF and quantum energies."
msgstr "绘制 HF 能量与量子能量的相关关系。"

#: of q2m3.utils.plotting.plot_energy_comparison:3
msgid ""
"Creates a two-panel figure: (1) scatter plot of HF vs quantum energies with y=x reference line, "
"(2) histogram of energy differences."
msgstr "创建双面板图：(1) HF 能量与量子能量的散点图，含 y=x 参考线；(2) 能量差的直方图。"

#: of q2m3.utils.plotting.plot_energy_comparison:6
msgid "HF energies at quantum evaluation steps"
msgstr "量子计算步骤对应的 HF 能量"

#: of q2m3.utils.plotting.plot_energy_comparison:7
msgid "Quantum algorithm energy estimates"
msgstr "量子算法估计的能量"

#: of q2m3.utils.plotting.plot_energy_comparison:8
msgid "Plot title"
msgstr "图标题"

#: of q2m3.utils.plotting.plot_energy_comparison:9
msgid "Path to save figure"
msgstr "图的保存路径"

#: of q2m3.utils.plotting.plot_energy_comparison:10
msgid "Whether to display"
msgstr "是否显示图"

#: of q2m3.utils.plotting.plot_energy_comparison:12
msgid "Matplotlib Figure object"
msgstr "Matplotlib Figure 对象"
